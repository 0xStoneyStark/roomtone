# Get a key at https://console.typesafe.ai — never commit the real .env
TYPESAFE_API_KEY=
# Optional
PORT=8790
# Set to 1 behind Cloudflare / nginx so rate limits see real client addresses
TRUST_PROXY=0
# Ceiling on Jev input tokens across all visitors per rolling hour (8M ≈ $0.34)
TOKEN_BUDGET_PER_HOUR=8000000
